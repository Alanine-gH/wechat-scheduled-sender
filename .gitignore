# ===========================================================================
#  重要：以下内容**绝对不能**提交到仓库
#  ---------------------------------------------------------------------------
#  这些是运行期产生的用户文件，里面含有能解密微信数据库的密钥、
#  解密后的通讯录数据、以及真实聊天截图。一旦推到远程（尤其公开仓库），
#  等于把自己的聊天记录全部公开。
#  仓库里只保留源代码与文档；用户文件一律留在本机安装目录。
# ===========================================================================

# --- 密钥与解密数据（最敏感）---
cache/
tmp/

# --- 真实聊天截图与运行日志 ---
shots/
logs/

# --- 用户内容与本地配置 ---
# 注意：data/messages.txt 是消息池，属于使用者自己的内容，默认不提交；
#      仓库里放 data/messages.example.txt 作为模板。
data/messages.txt
data/settings.json
data/media/
data/recall/

# --- Electron / Chromium 运行期数据 ---
runtime/

# --- 依赖与构建产物 ---
node_modules/
dist/
out/
npm-debug.log*
npm-install.log

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- 编辑器 / 系统 ---
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- 凭据 / 环境 ---
.env
.env.*
*.pem
*.key

# --- 兜底：任何以 _ 开头的本地调试脚本 ---
_*.py
_*.js
_*.ps1
_*.txt